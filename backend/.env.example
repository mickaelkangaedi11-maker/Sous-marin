# Kanga Holding Group CCG - Configuration Backend

# Base de données
DATABASE_URL=postgresql://user:password@localhost:5432/kanga_holding
DATABASE_POOL_SIZE=20

# API Keys
OPENAI_API_KEY=sk-xxx
ANTHROPIC_API_KEY=xxx
HUGGINGFACE_API_KEY=xxx

# Services Externes
STRIPE_API_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Dropshipping
SHOPIFY_API_KEY=xxx
SHOPIFY_API_PASSWORD=xxx
SHOPIFY_SHOP_URL=xxx.myshopify.com

# Mail & Notifications
SENDGRID_API_KEY=xxx
TWILLIO_API_KEY=xxx

# JWT
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRATION=7d

# Redis (Cache & Queue)
REDIS_URL=redis://localhost:6379

# Prospecting Settings
PROSPECT_MIN_LEAD_SCORE=50
PROSPECT_MAX_RETRIES=3
PROSPECT_TIMEOUT=30000

# Ports
API_PORT=3000
WS_PORT=3001

# Environment
NODE_ENV=development
DEBUG=true